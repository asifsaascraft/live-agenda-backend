# ---- AiSensy (AISENSY_API_KEY + AISENSY_CAMPAIGN_NAME already exist for registration) ----
AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=                # existing: registration pass campaign
AISENSY_AGENDA_CAMPAIGN_NAME=         # NEW: API campaign whose template has a DOCUMENT header + 4 variables

# ---- Agenda share ----
# Public origin of THIS backend. AiSensy downloads the PDF from here, so it must be reachable
# from the internet (https in production). Local dev: use a tunnel (ngrok / cloudflared).
AGENDA_PUBLIC_BASE_URL=https://api.yourdomain.com
# Website shown in the message as {{4}}
AGENDA_SITE_URL=https://aroicon2026.com

# ---- Optional ----
AGENDA_EVENT_NAME=AROICON 2026
AGENDA_FILES_DIR=                     # default: <cwd>/storage/agenda-pdfs
AGENDA_FILE_RETENTION_HOURS=48
AGENDA_SHARE_MAX_PER_PHONE_PER_HOUR=3
AGENDA_SHARE_COOLDOWN_SECONDS=30
AGENDA_SHARE_IP_MAX=10
AGENDA_SHARE_IP_WINDOW_MINUTES=10
# Unicode PDF fonts (only needed for non-Latin names):
# AGENDA_PDF_FONT_REGULAR=/app/fonts/NotoSans-Regular.ttf
# AGENDA_PDF_FONT_BOLD=/app/fonts/NotoSans-Bold.ttf
